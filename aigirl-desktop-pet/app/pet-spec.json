{
  "schemaVersion": 5,
  "app": {
    "name": "蓝蓝桌宠",
    "appId": "com.doubao.lanlanpet",
    "version": "1.0.0",
    "language": "zh-CN"
  },
  "targets": {
    "windows": { "enabled": true, "arch": "x64" },
    "macos": { "enabled": false, "arch": "current" }
  },
  "character": {
    "inputType": "single-image",
    "coreAsset": "core-ip/core-ip.png",
    "displayName": "蓝蓝",
    "archetype": "person",
    "personality": ["元气", "活泼", "黏人", "话痨"],
    "preserveTraits": ["浅蓝色双马尾", "蓝色大眼睛", "黑色蝴蝶结发饰", "白色圆点发饰", "蓝绿色颈链", "黑色露肩短上衣", "呆毛"],
    "style": "custom",
    "mirrorSafe": true
  },
  "assetPipeline": {
    "backgroundMode": "semantic-cutout",
    "segmentationBackend": "auto",
    "subjectKind": "illustration",
    "generationBackground": "transparent-grid",
    "backgroundTolerance": 28,
    "edgeFeather": 12,
    "safeMargin": 24,
    "targetOccupancy": 0.78
  },
  "experience": {
    "theme": {
      "primary": "#4FC3F7",
      "accent": "#81D4FA",
      "background": "#E1F5FE",
      "surface": "#FFFFFF",
      "text": "#263238",
      "muted": "#78909C",
      "cornerRadius": 20
    },
    "petSizing": {
      "baseWindowPx": 220,
      "defaultScale": 0.8
    },
    "interactions": [
      {
        "id": "chat",
        "emoji": "💬",
        "label": "陪我聊聊天",
        "stateId": "chat",
        "durationMs": 4000,
        "affectionGain": 2,
        "feedback": ["今天过得怎么样呀？", "陪你聊天最开心啦！", "想听我讲个小秘密吗？", "你敲键盘的声音好好听~"]
      },
      {
        "id": "pet-head",
        "emoji": "💗",
        "label": "摸摸头",
        "stateId": "pet-head",
        "durationMs": 2200,
        "affectionGain": 3,
        "feedback": ["呜…好舒服~", "再摸摸嘛", "被你摸头最幸福啦", "头发都摸乱啦！"]
      },
      {
        "id": "feed",
        "emoji": "🍰",
        "label": "喂吃的",
        "stateId": "feed",
        "durationMs": 2600,
        "affectionGain": 5,
        "feedback": ["好好吃！谢谢~", "甜点最棒啦！", "再来一块嘛~", "呜…太好吃了"]
      },
      {
        "id": "walk",
        "emoji": "🚶",
        "label": "让她走路",
        "stateId": "walk",
        "durationMs": 10000,
        "affectionGain": 2,
        "feedback": ["走一走真开心！", "我们去散步吧~", "活动一下身体~", "跟着我走起来！"]
      },
      {
        "id": "coffee",
        "emoji": "☕",
        "label": "请她喝咖啡",
        "stateId": "coffee",
        "durationMs": 2800,
        "affectionGain": 4,
        "feedback": ["咖啡好香呀~", "暖暖的，好幸福", "谢谢你的咖啡！", "再来一杯嘛~"]
      },
      {
        "id": "sleep",
        "emoji": "😴",
        "label": "让她睡觉",
        "stateId": "sleep",
        "durationMs": 8000,
        "affectionGain": 1,
        "feedback": ["晚安啦…", "好困呀，呼~", "做个好梦…", "嘘…睡着了"]
      }
    ]
  },
  "motion": {
    "breathing": { "enabled": true, "periodMs": 3200, "scaleX": 0.012, "scaleY": 0.022 },
    "squashStretch": { "enabled": true, "durationMs": 320, "intensity": 0.09 },
    "idleIntervalMs": { "min": 7000, "max": 13000 }
  },
  "features": {
    "transparentWindow": true,
    "drag": true,
    "tray": true,
    "edgeSnap": false,
    "reminders": true,
    "interactions": true,
    "relationship": true,
    "filePocket": false,
    "dashboard": true,
    "typingReaction": false,
    "autonomousMovement": true
  },
  "states": [
